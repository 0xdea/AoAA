#!/bin/bash

#
# build - Automatically builds an AoAA example program from the command line
#
# Usage:
# $ build [-c] <filename>
# (no extension in the filename)
#
# Options:
# -c: assemble .S file to object code only
#

set -euo pipefail

compiler="g++ -Wall -Wextra"
filename=""
compileonly=false
cppfile="listing1-4.cpp"

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
	case "$1" in
	-c)
		compileonly=true
		shift
		;;
	*)
		filename="$1"
		shift
		;;
	esac
done

if [[ -z "$filename" ]]; then
	echo "Usage: build [-c] <filename>" >&2
	exit 1
fi

# Exit if the user specifies a .s or .S extension in the file name. Also reject a leading '-' (rm/g++ would
# parse it as an option) and any '/' (keeps the build confined to a bare filename in the current directory).
case "$filename" in
-*)
	echo "Argument should not start with '-'" >&2
	exit 1
	;;
*/*)
	echo "Argument should be a bare filename, not a path" >&2
	exit 1
	;;
*.S)
	echo "Argument should not have an .S extension" >&2
	exit 1
	;;
*.s)
	echo "Argument should not have an .s extension" >&2
	exit 1
	;;
esac

# Delete any stale executable/object file.
rm -f -- "$filename" "$filename".o

# If the -c option was provided, only assemble the .S file and produce a .o output file.
# Otherwise, compile and link both the .cpp and the .S file and produce an executable.
if $compileonly; then
	$compiler -c -o "$filename".o "$filename".S
else
	$compiler -o "$filename".out "$cppfile" "$filename".S
fi
